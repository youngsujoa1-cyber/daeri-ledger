<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="9dp">

    <!-- 이름과 금액이 한 줄. 금액이 5억처럼 길어져도 이름이 '개…' 로 눌리지 않도록
         이름은 최소 폭을 갖고(weight 1), 금액은 필요한 만큼만 쓴다. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rowName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:minWidth="68dp"
            android:text="카카오T"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="258,000원"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="12콜 · 콜당 21,500원"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/rowBar"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="7dp"
        app:indicatorColor="@color/chart_bar"
        app:trackColor="@color/chart_bar_dim"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />
</LinearLayout>
