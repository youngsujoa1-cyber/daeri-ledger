<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <EditText
        android:id="@+id/spotNameInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_amount_field"
        android:hint="콜밭 이름 (예: 우리 동네 사거리)"
        android:imeOptions="actionNext"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="30"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/spotPeakInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_amount_field"
        android:hint="피크 시간대 (예: 23:00~02:00)"
        android:imeOptions="actionNext"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="30"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/spotMemoInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_amount_field"
        android:hint="메모 (예: 2차 골목, 대기 10분)"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="60"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="15sp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/useLocationSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="48dp"
        android:text="현재 위치를 이 콜밭 위치로 저장"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/locationValueText"
        style="@style/Text.Daeri.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="위치 권한이 없으면 이름만 저장돼요"
        android:textSize="11sp" />

</LinearLayout>
