<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/spotsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/spotsColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Daeri.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="콜밭" />

                    <TextView
                        android:id="@+id/spotsSubtitle"
                        style="@style/Text.Daeri.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="주요 콜밭 · 피크 시간대 참고 정보" />
                </LinearLayout>

                <!-- 내가 다니는 콜밭을 직접 추가 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addSpotButton"
                    style="@style/Widget.Daeri.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:minHeight="42dp"
                    android:paddingHorizontal="14dp"
                    android:text="+ 콜밭 추가"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 위치 상태 -->
            <LinearLayout
                android:id="@+id/locationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_route"
                    app:tint="@color/accent" />

                <TextView
                    android:id="@+id/locationText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="위치를 확인하면 가까운 순으로 정렬합니다"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/locationAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:text="위치 켜기"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 콜밭 검색 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_amount_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <EditText
                    android:id="@+id/spotSearch"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="지역·역·동 검색 (예: 동탄, 수지, 강남)"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="24"
                    android:paddingVertical="0dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/spotSearchClear"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="검색어 지우기"
                    android:padding="6dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- 시·도 필터 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:paddingHorizontal="18dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/regionChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <!-- 숨긴 콜밭이 있을 때만 보인다 -->
            <TextView
                android:id="@+id/hiddenInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingVertical="4dp"
                android:text="숨긴 콜밭 0곳 · 되돌리기"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- 콜밭 지도 (v1.0.21) — 카카오맵에 콜밭을 핀으로 (지역 · 검색 필터를 따라간다) -->
            <LinearLayout
                android:id="@+id/mapCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_soft"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="콜밭 지도"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mapCountLabel"
                        style="@style/Text.Daeri.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="" />

                    <TextView
                        android:id="@+id/mapMyLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="6dp"
                        android:text="내 위치"
                        android:textColor="@color/accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mapToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="6dp"
                        android:text="크게"
                        android:textColor="@color/accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/mapFrame"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:background="@drawable/bg_map_frame"
                    android:clipToOutline="true">

                    <WebView
                        android:id="@+id/mapWeb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/mapLoading"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#E9EEF3"
                        android:gravity="center"
                        android:text="지도를 불러오는 중…"
                        android:textColor="#5A6A7B"
                        android:textSize="12sp" />

                    <!-- 카카오맵을 못 띄웠을 때 — 앱은 그대로 쓰고 다시 시도할 수 있다 -->
                    <LinearLayout
                        android:id="@+id/mapErrorBox"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#E9EEF3"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/mapErrorText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:text="카카오맵을 불러오지 못했어요.&#10;아래 콜밭 목록으로도 볼 수 있어요."
                            android:textColor="#5A6A7B"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mapRetryButton"
                            style="@style/Widget.Daeri.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:minHeight="40dp"
                            android:text="다시 시도"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- 핀을 누르면 지도 아래쪽에 뜨는 카드 -->
                    <LinearLayout
                        android:id="@+id/mapPinCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_card_soft"
                        android:elevation="6dp"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/mapPinName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/mapPinMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/mapPinMemo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/text_tertiary"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/mapPinRoute"
                                style="@style/Widget.Daeri.Button.Tonal"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:minHeight="40dp"
                                android:paddingHorizontal="14dp"
                                android:text="길찾기"
                                android:textSize="12sp"
                                app:icon="@drawable/ic_route"
                                app:iconSize="15dp" />

                            <TextView
                                android:id="@+id/mapPinClose"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="?attr/selectableItemBackground"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="8dp"
                                android:text="닫기"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/mapAttribution"
                    style="@style/Text.Daeri.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingHorizontal="4dp"
                    android:text="지도 © Kakao Corp. · 핀을 누르면 이름·피크·메모가 떠요"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 주요 콜밭 — 내가 추가한 콜밭도 `내 콜밭` 배지로 여기 함께 보인다 (v1.0.21: 위쪽 별도 섹션 제거) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingTop="22dp"
                android:paddingBottom="4dp">

                <TextView
                    style="@style/Text.Daeri.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="콜밭 목록" />

                <TextView
                    android:id="@+id/nearbyCountText"
                    style="@style/Text.Daeri.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nearbyColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 300곳 이상 목록은 40곳씩 나눠서 그린다 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/moreSpotsButton"
                style="@style/Widget.Daeri.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="6dp"
                android:minHeight="48dp"
                android:text="나머지 콜밭 더 보기"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                style="@style/Text.Daeri.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="3dp"
                android:text="* 콜밭 정보는 지역 특성과 기사님들이 모아 둔 지도 즐겨찾기를 정리한 참고 자료이며, 카카오T·로지 등 플랫폼의 실시간 콜 수량이 아닙니다.&#10;* 없어진 곳은 카드를 길게 눌러 ‘내 화면에서만 숨기기’ 또는 ‘없어진 곳 신고’를 할 수 있어요. 신고는 같은 자리에서 5명 이상 모이면 모든 기사님 화면에서 숨겨지고, 내 화면에서는 바로 숨겨집니다.&#10;* 기사님들이 5명 이상 제보한 곳은 ‘기사 제보’ 로 목록에 함께 보입니다.&#10;* 내가 추가한 콜밭(‘내 콜밭’ 배지)은 카드를 길게 눌러 삭제할 수 있어요."
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
