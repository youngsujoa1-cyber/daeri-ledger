<?xml version="1.0" encoding="utf-8"?>
<!-- 지도에서 위치 고르기: OSM 타일 지도 위에 정중앙 고정 핀, 아래 주소 카드와 `이 위치 선택` -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.youngsu.daeriledger.ui.widget.SpotMapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 상단 바 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="닫기"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🗺️ 지도에서 위치 고르기"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <!-- 오른쪽 확대·축소·내 위치 -->
    <LinearLayout
        android:id="@+id/sideButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/zoomInButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle"
            android:clickable="true"
            android:contentDescription="지도 확대"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_add"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/zoomOutButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_circle"
            android:clickable="true"
            android:contentDescription="지도 축소"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_minus"
            app:tint="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/myLocationButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:minHeight="42dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="내 위치"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            app:backgroundTint="@color/surface_high"
            app:cornerRadius="21dp"
            app:icon="@drawable/ic_my_location"
            app:iconPadding="4dp"
            app:iconSize="15dp"
            app:iconTint="@color/text_primary" />
    </LinearLayout>

    <!-- 하단 주소 카드 + 이 위치 선택 -->
    <LinearLayout
        android:id="@+id/bottomCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card_soft"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/hintText"
            style="@style/Text.Daeri.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="지도를 움직여 핀 끝을 콜밭 자리에 맞춰 주세요"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/addressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="주소를 찾는 중…"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/coordText"
            style="@style/Text.Daeri.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmButton"
            style="@style/Widget.Daeri.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:minHeight="54dp"
            android:text="이 위치 선택"
            android:textSize="16sp" />
    </LinearLayout>

</FrameLayout>
