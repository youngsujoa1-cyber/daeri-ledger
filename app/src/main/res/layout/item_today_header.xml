<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dateText"
                style="@style/Text.Daeri.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:text="11월 23일 (일)" />

            <TextView
                android:id="@+id/businessDayText"
                style="@style/Text.Daeri.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="영업일 기준 12:00" />
        </LinearLayout>

        <TextView
            android:id="@+id/offDayToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="11dp"
            android:paddingVertical="6dp"
            android:text="휴무"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/livePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_accent"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="오늘"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 오늘 총수입 카드 -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Daeri.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Daeri.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="오늘 총수입" />

                <TextView
                    android:id="@+id/callCountText"
                    style="@style/Text.Daeri.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="콜 0건" />
            </LinearLayout>

            <TextView
                android:id="@+id/incomeAmountText"
                style="@style/Text.Daeri.Amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFeatureSettings="tnum"
                android:text="0원"
                android:textColor="@color/profit" />

            <TextView
                android:id="@+id/unpaidInlineText"
                style="@style/Text.Daeri.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/unpaid"
                android:visibility="gone"
                android:text="미수 0원 포함" />

            <View
                style="@style/Widget.Daeri.Divider"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Daeri.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="순수익" />

                    <TextView
                        android:id="@+id/netText"
                        style="@style/Text.Daeri.AmountSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFeatureSettings="tnum"
                        android:text="0원" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Daeri.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="지출" />

                    <TextView
                        android:id="@+id/expenseText"
                        style="@style/Text.Daeri.AmountSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFeatureSettings="tnum"
                        android:text="0원" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Daeri.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="수수료·보험" />

                    <TextView
                        android:id="@+id/costText"
                        style="@style/Text.Daeri.AmountSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFeatureSettings="tnum"
                        android:text="0원" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Daeri.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="일일 목표" />

                <TextView
                    android:id="@+id/goalRateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="0%"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/goalBar"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="8dp"
                app:indicatorColor="@color/profit"
                app:trackColor="@color/surface_high"
                app:trackCornerRadius="5dp"
                app:trackThickness="10dp" />

            <TextView
                android:id="@+id/goalHintText"
                style="@style/Text.Daeri.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="목표 300,000원까지 150,000원 남았어요" />

            <TextView
                android:id="@+id/paceText"
                style="@style/Text.Daeri.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_tertiary"
                android:text="시간당 0원 · 콜당 0원" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
