<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/netShownSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="앱에 수수료 차감 후 금액이 보임"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        style="@style/Text.Daeri.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:text="켜면 앱에 보이는 금액(수수료 떼고 받은 돈)을 입력합니다. 총매출은 아래 수수료율로 역산해요. 카카오T·티맵·핸들은 보통 켜져 있어요."
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/feeInputRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_amount_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <EditText
            android:id="@+id/feePercentInput"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFeatureSettings="tnum"
            android:gravity="end|center_vertical"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLength="5"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="%"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/feePresets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:chipSpacingHorizontal="7dp"
        app:chipSpacingVertical="4dp" />

    <TextView
        android:id="@+id/feeExample"
        style="@style/Text.Daeri.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text=""
        android:textColor="@color/accent"
        android:textSize="12sp" />

</LinearLayout>
