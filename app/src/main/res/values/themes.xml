<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DaeriLedger.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_dim</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/profit</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/profit_dim</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorTertiary">@color/chart_bar</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_high</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_alt</item>
        <item name="colorSurfaceContainerHighest">@color/surface_high</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorError">@color/loss</item>
        <item name="colorOnError">#FFFFFF</item>

        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowActionModeOverlay">true</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Daeri.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Daeri.BottomSheet</item>
        <item name="android:fontFamily">sans-serif</item>

        <item name="shapeAppearanceCornerExtraSmall">@style/Shape.Daeri.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/Shape.Daeri.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.Daeri.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.Daeri.Large</item>
    </style>

    <style name="Theme.DaeriLedger" parent="Theme.DaeriLedger.Base" />

    <!-- 지도에서 위치 고르기 — 화면을 꽉 채우는 다이얼로그 -->
    <style name="Theme.DaeriLedger.FullScreen" parent="Theme.DaeriLedger">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Shape.Daeri.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Shape.Daeri.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Shape.Daeri.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="Shape.Daeri.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">26dp</item>
    </style>

    <style name="ThemeOverlay.Daeri.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_alt</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="shapeAppearanceOverlay">@style/Shape.Daeri.Large</item>
    </style>

    <style name="ThemeOverlay.Daeri.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurface">@color/surface_alt</item>
        <item name="bottomSheetStyle">@style/Widget.Daeri.BottomSheet</item>
    </style>

    <style name="Widget.Daeri.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/Shape.Daeri.Large</item>
        <item name="backgroundTint">@color/surface_alt</item>
    </style>

    <!-- ============================================================ text -->

    <style name="Text.Daeri.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Daeri.Label" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Daeri.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Daeri.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Daeri.Amount" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">38sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Daeri.AmountSmall" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ========================================================== widgets -->

    <style name="Widget.Daeri.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent_dim</item>
        <item name="android:width">56dp</item>
        <item name="android:height">30dp</item>
    </style>

    <style name="TextAppearance.Daeri.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>


    <style name="Widget.Daeri.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_alt</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="Widget.Daeri.Card.Accent" parent="Widget.Daeri.Card">
        <item name="strokeColor">@color/accent</item>
    </style>

    <style name="Widget.Daeri.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconTint">@color/on_accent</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Widget.Daeri.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/surface_high</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconTint">@color/text_primary</item>
    </style>

    <style name="Widget.Daeri.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/accent_dim</item>
    </style>

    <style name="Widget.Daeri.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinHeight">44dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStartPadding">14dp</item>
        <item name="chipEndPadding">14dp</item>
        <item name="rippleColor">@color/accent_dim</item>
    </style>

    <style name="Widget.Daeri.Chip.Amount" parent="Widget.Daeri.Chip">
        <item name="chipMinHeight">50dp</item>
        <item name="android:textSize">16sp</item>
        <item name="chipCornerRadius">16dp</item>
    </style>

    <!-- 누르면 동작하는 작은 칩 (📍 현위치) — 고르는 칩이 아니라 실행 버튼 -->
    <style name="Widget.Daeri.Chip.Action" parent="Widget.Material3.Chip.Assist">
        <item name="chipMinHeight">40dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
        <item name="chipBackgroundColor">@color/accent_dim</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="rippleColor">@color/accent_dim</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="Widget.Daeri.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Daeri.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="Widget.Daeri.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/accent</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.Daeri.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
